# Skopiuj jako .env i uzupełnij:  cp .env.example .env && chmod 600 .env
# Plik .env zostaje tylko na serwerze – jest w .gitignore.

# --- stary HA (dewelopera) ---
# W sieci domowej (szybciej):
OLD_HA_URL=http://10.0.0.199:8123
# Albo zdalnie przez internet:
OLD_HA_TOKEN=wklej_token_ze_starego_HA
# Ustaw false tylko, jeśli stary HA ma https z certyfikatem self-signed
VERIFY_SSL=true

# --- nowy HA ---
# Token utworzysz w profilu nowego HA (Profil → Bezpieczeństwo → Tokeny długoterminowe)
NEW_HA_TOKEN=wklej_token_z_nowego_HA

# --- odczyt czujników ---
DOMAINS=sensor,binary_sensor
PREFIX=dom_
RESYNC_SECONDS=300

# --- sterowanie temperaturą (wyłącznie set_temperature, tylko te termostaty) ---
# Pusta lista = tylko odczyt.
CLIMATE_CONTROL=climate.ogrzewanie_salon,climate.ogrzewanie_kuchnia,climate.ogrzewanie_pokoj_1,climate.ogrzewanie_wc,climate.ogrzewanie_wiatrolap,climate.ogrzewanie_p1_pokoj_1,climate.ogrzewanie_p1_pokoj_2,climate.ogrzewanie_p1_pokoj_3,climate.ogrzewanie_p1_pokoj_4,climate.ogrzewanie_p1_lazienka_1,climate.ogrzewanie_p1_lazienka_2
MIN_SETPOINT=10
MAX_SETPOINT=28

# --- sterowanie przełącznikami i roletami/bramą ---
# Nazwy encji po przecinku, * = wszystkie, puste = brak sterowania.
SWITCH_CONTROL=*
COVER_CONTROL=*

# Rolety z pozycją "na czas" (Domatiq nie wykonuje set_cover_position). * = wszystkie, puste = wyłączone.
COVER_TIMED=cover.roleta_p1_pokoj_1,cover.roleta_p1_pokoj_2,cover.pergola
# Czas pełnego przejazdu (zamknięta -> otwarta) w sekundach; osobno dla wybranych: cover.x:25,cover.y:28
COVER_TRAVEL_SECONDS=30
COVER_TRAVEL_TIMES=
